# DocsGen configuration (all optional).
# Normal use needs NO environment variables: providers, API keys, models and MCP servers are configured
# in the Streamlit UI. Copy to .env and export the values (or use .streamlit/secrets.toml) only if you
# want to override defaults.

# Where configuration, encrypted credentials, uploads and generated documents are stored.
# DOCSGEN_DATA_DIR=./.docsgen_data

# Master key for the encrypted credential store (Fernet key). If unset, a key is generated once and
# written to <data dir>/master.key with owner-only permissions. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DOCSGEN_MASTER_KEY=

# Limits and policies (also editable in Application Settings)
# DOCSGEN_MAX_UPLOAD_MB=25
# DOCSGEN_MAX_SOURCE_FILES=20
# DOCSGEN_AGENT_TIMEOUT_SECONDS=300
# DOCSGEN_AGENT_CONTEXT_CHARS=60000
# DOCSGEN_MCP_STARTUP_TIMEOUT=30
# DOCSGEN_MCP_TOOL_TIMEOUT=60
# DOCSGEN_STDIO_COMMAND_ALLOWLIST=python,python3,uv,uvx,npx,node,docker,deno,bunx
# DOCSGEN_ALLOW_INSECURE_HTTP_LOCALHOST=true
# DOCSGEN_ALLOW_INSECURE_HTTP_REMOTE=false
# DOCSGEN_LOG_LEVEL=INFO

# Optional provider fallbacks. Keys entered in the UI take precedence over these.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# AWS_PROFILE= / AWS_REGION=          (Bedrock "default credential chain" mode)

# Live integration tests (pytest -m live)
# DOCSGEN_LIVE_PROVIDER=openai
# DOCSGEN_LIVE_MODEL=gpt-4o-mini
